    "from torch.nn.functional import interpolate\n",
    "\n",
    "def resize(y, x, task_name):\n",
    "    if y.shape != x.shape:\n",
    "        ry = interpolate(y, size=x.shape[-2:], mode='bilinear', align_corners=False)\n",
    "    else:\n",
    "        ry = y\n",
    "    if task_name == 'phase_retrieval':\n",
    "        def norm_01(y):\n",
    "            tmp = (y - y.mean()) / y.std()\n",
    "            tmp = tmp.clip(-0.5, 0.5) * 3\n",
    "            return tmp\n",
    "\n",
    "        ry = norm_01(ry) * 2 - 1\n",
    "    return ry"
   ]
